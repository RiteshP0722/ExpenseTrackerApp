# Copy this file to .env and fill in the values from
# Supabase → Project Settings → API.
# Never commit .env (it is in .gitignore).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public "anon" key (legacy JWT) or the new "publishable" key (sb_publishable_...).
# Both are safe to ship in the app; Row Level Security protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Older name, still accepted by the app if ANON_KEY is not set:
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
