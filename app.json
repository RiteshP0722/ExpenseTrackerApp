{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expense-tracker-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F4EF"
    },
    "scheme": "expensetracker",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.acmetraders.expensetracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#2F7A5B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.acmetraders.expensetracker",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Expense Tracker to choose a bill photo from your gallery.",
          "cameraPermission": "Allow Expense Tracker to take a photo of the bill."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
